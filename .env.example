# Copy to .env.local. Never commit real credentials.
DATABASE_URL=postgresql://APPLICATION_USER:APPLICATION_PASSWORD@127.0.0.1:5432/patience_local
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET
# Optional, disposable test database only. Tests reset its public schema.
# PATIENCE_TEST_DATABASE_URL=postgresql://APPLICATION_USER:APPLICATION_PASSWORD@127.0.0.1:5432/patience_catalog_test_LOCAL
# Optional private document provider:

# Optional custom PostgreSQL Windows tools folder:
# PG_BIN=C:/Program Files/PostgreSQL/17/bin

# Required only for the one-time first administrator setup
PATIENCE_SETUP_TOKEN=
PG_POOL_MAX=10

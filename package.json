{
  "name": "la-patience",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:studio": "drizzle-kit studio --host=127.0.0.1 --port=4983",
    "test:catalogue": "node --conditions=react-server --require tsx/cjs --test tests/catalogue/*.test.cjs",
    "test:catalogue:build": "node scripts/catalogue-test-runtime.cjs build",
    "test:catalogue:serve": "node scripts/catalogue-test-runtime.cjs start",
    "test:catalogue:http": "node scripts/catalogue-http-smoke.mjs",
    "delivery:inspect": "node scripts/prepare-delivery.mjs",
    "delivery:prepare": "node scripts/prepare-delivery.mjs --execute",
    "check": "npm run typecheck && npm run test:catalogue && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/functions": "^3.11.2",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "decimal.js-light": "^2.5.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
